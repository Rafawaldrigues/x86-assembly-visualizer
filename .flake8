# flake8 configuration.
#
# black handles formatting (see [tool.black] in pyproject.toml) and flake8
# handles the rest: names, imports, complexity and long lines. Both tools agree
# on 100 columns, and E203/W503 are ignored because black itself produces those
# two shapes.
[flake8]
max-line-length = 100
extend-ignore = E203, W503
exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    build,
    dist,
    *.egg-info
# The virtual machine and the analyzer are long dispatch tables (one if/elif per
# instruction), so their cyclomatic complexity is high by nature and is covered
# by tests; the limit here is there to catch a new function that grows without
# need. `Machine.step`, the largest of them, carries an explicit noqa.
max-complexity = 45
